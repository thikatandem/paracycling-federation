extends ../../_layout/default

block view

  .container-fluid

    .row
      .col-12

        .card.mb-4

          .card-header.d-flex.justify-content-between.align-items-center

            strong Event Master

            .d-flex.gap-2

              button.btn.btn-primary(
                type='button'
                id='btnNewEvent'
              )

                i.fa.fa-plus.me-2

                | New Event Master

          .card-body

            .row.mb-3

              .col-md-4

                input.form-control(
                  type='text'
                  id='searchEvent'
                  placeholder='Search Event Masters'
                )

            .table-responsive

              table.table.table-striped.table-hover

                thead

                  tr
                    th Event Name
                    th Event Category
                    th Event Type
                    th Status
                    th Actions

                tbody#eventTableBody

            .row.mt-3

              .col-md-6
                small.text-muted#paginationInfo

              .col-md-6.text-end
                ul.pagination.justify-content-end.mb-0#paginationContainer

  .modal.fade(
    id='eventModal'
    tabindex='-1'
    aria-hidden='true'
  )

    .modal-dialog

      .modal-content

        .modal-header

          h5.modal-title Event Master

          button.btn-close(
            type='button'
            data-coreui-dismiss='modal'
          )

        .modal-body

          input(
            type='hidden'
            id='eventId'
          )

          
          .mb-3

            label.form-label Event Name

            input.form-control(
              id='eventName'
              list='eventNameSuggestions'
              placeholder='Enter Event Name'
            )

            datalist#eventNameSuggestions

          .mb-3

            label.form-label Event Category

            select.form-select(
              id='eventCategoryId'
            )
              option(value='') Select Event Category

          .mb-3

            label.form-label Event Type

            select.form-select(
              id='eventTypeId'
            )
              option(value='') Select Event Type

          .mb-3.d-none(
            id='eventStatusContainer'
          )

            label.form-label Status

            select.form-select(
              id='eventStatusId'
            )
              option(value='') Select Status

          .alert.alert-danger.d-none(
            id='eventError'
          )

        .modal-footer

          button.btn.btn-secondary(
            type='button'
            data-coreui-dismiss='modal'
          )
            | Close

          button.btn.btn-primary(
            type='button'
            id='btnSaveEvent'
          )
            | Save Event


append pageScripts

  script(type='module' src='js/core/events/events-master.js')
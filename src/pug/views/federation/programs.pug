extends ../../_layout/default

block view

  .container-fluid

    .row
      .col-12

        .card.mb-4

          .card-header.d-flex.justify-content-between.align-items-center

            strong Program Master

            button.btn.btn-primary(
              type='button'
              id='btnProgramMaster'
            )
              i.fa.fa-plus.me-2
              | New Program

          .card-body

            .alert.alert-danger.d-none(
              data-feedback='program'
            )

            .table-responsive

              table.table.table-striped.table-hover

                thead
                  tr
                    th Code
                    th Program
                    th Duration
                    th Status
                    th Actions

                tbody#programTableBody

  .modal.fade(
    id='programModal'
    tabindex='-1'
    aria-hidden='true'
  )

    .modal-dialog.modal-lg

      .modal-content

        .modal-header

          h5.modal-title Program Master

          button.btn-close(
            type='button'
            data-coreui-dismiss='modal'
          )

        .modal-body

          .alert.alert-danger.d-none(
            data-feedback='program'
          )

          input(
            type='hidden'
            id='programId'
          )

          .row

            .col-md-2.mb-3

              label.form-label Program Code

              input.form-control(
                id='programCode'
                readonly
                placeholder='Auto'
              )

            .col-md-5.mb-3

              label.form-label Program Name

              input.form-control(
                id='programName'
                list='programNameSuggestions'
              )

              datalist#programNameSuggestions

            .col-md-3.mb-3

              label.form-label Duration (Days)

              input.form-control(
                type='number'
                id='programDurationDays'
                value='1'
                min='1'
              )

          .row

            .col-md-5.mb-3

              label.form-label Interval

              select.form-select(
                id='programRecurrenceTypeId'
              )
                option(value='') Select Recurrence

            .col-md-7.mb-3.d-flex.align-items-end

              button.btn.btn-success.w-100(
                type='button'
                id='btnSaveProgram'
              )
                | Save Program

          hr.my-4

          #scheduleSection.d-none

            h5.mb-3 Program Schedules

            .card.border-primary.mb-4

              .card-header.bg-primary.text-white
                strong Selected Program

              .card-body

                .row

                  .col-md-3.mb-3
                    label.form-label Program
                    input.form-control(
                      id='selectedProgramName'
                      readonly
                    )

                  .col-md-2.mb-3
                    label.form-label Code
                    input.form-control(
                      id='selectedProgramCode'
                      readonly
                    )

                  .col-md-2.mb-3
                    label.form-label Duration
                    input.form-control(
                      id='selectedProgramDuration'
                      readonly
                    )

                  .col-md-3.mb-3
                    label.form-label Interval
                    input.form-control(
                      id='selectedProgramInterval'
                      readonly
                    )

                  .col-md-2.mb-3
                    label.form-label Status
                    input.form-control(
                      id='selectedProgramStatus'
                      readonly
                    )

            input(
              type='hidden'
              id='scheduleId'
            )

            input(
              type='hidden'
              id='scheduleProgramId'
            )

            .row

              .col-md-3.mb-3
                label.form-label Start Date
                input.form-control(
                  type='date'
                  id='scheduleStartDate'
                )

              .col-md-2.mb-3
                label.form-label Day
                input.form-control(
                  id='scheduleDay'
                  readonly
                )

              .col-md-3.mb-3
                label.form-label End Date
                input.form-control(
                  type='date'
                  id='scheduleEndDate'
                )

            .row

              .col-md-6.mb-3
                label.form-label Schedule Name
                input.form-control(
                  id='scheduleName'
                  placeholder='Schedule Name'
                )

              .col-md-3.mb-3
                label.form-label Start Time
                input.form-control(
                  type='time'
                  id='scheduleStartTime'
                )

              .col-md-3.mb-3
                label.form-label End Time
                input.form-control(
                  type='time'
                  id='scheduleEndTime'
                )

              .col-md-3.mb-3.d-flex.align-items-end
                button.btn.btn-success.w-100(
                  type='button'
                  id='btnSaveSchedule'
                )
                  | Save Schedule

            .table-responsive.mt-4

              table.table.table-striped.table-hover

                thead
                  tr
                    th Schedule
                    th Start
                    th Day
                    th End
                    th Time
                    th Status
                    th Actions

                tbody#scheduleTableBody

        .modal-footer

          button.btn.btn-secondary(
            type='button'
            data-coreui-dismiss='modal'
          )
            | Close

append pageScripts

  script(type='module' src='js/core/programs/programs.js')

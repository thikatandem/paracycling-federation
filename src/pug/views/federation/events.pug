extends ../../_layout/default

block view

  .container-fluid

    .row
      .col-12

        .card.mb-4

          .card-header.d-flex.justify-content-between.align-items-center

            strong Event Occurrences

            .d-flex.align-items-center.gap-2

              button.btn.btn-primary(
                type='button'
                id='btnNewOccurrence'
              )

                i.fa.fa-plus.me-2

                | New Event Occurrence

              button.btn.btn-outline-secondary(
                type='button'
                id='btnDownloadEventTemplate'
              )

                i.fa.fa-download.me-2

                | Sample CSV

              button.btn.btn-success(
                type='button'
                id='btnImportEvents'
              )

                i.fa.fa-upload.me-2

                | Import Events

              input(
                type='file'
                id='eventImportFile'
                accept='.csv,.xlsx,.xls'
                hidden
              )

          .card-body

            .row.mb-3

              .col-md-4

                input.form-control(
                  type='text'
                  id='searchOccurrence'
                  placeholder='Search Event Occurrences'
                )

            .table-responsive

              table.table.table-striped.table-hover

                thead

                  tr

                    th Event Name
                    th Event Type
                    th Event Area
                    th Organizer
                    th Sponsor
                    th Start Date
                    th End Date
                    th Start Time
                    th End Time
                    th Participants
                    th Status
                    th Actions

                tbody#occurrenceTableBody

            .row.mt-3

              .col-md-6

                small.text-muted#paginationInfo

              .col-md-6.text-end

                ul.pagination.justify-content-end.mb-0#paginationContainer

  .modal.fade(
    id='occurrenceModal'
    tabindex='-1'
    aria-hidden='true'
  )

    .modal-dialog.modal-xl

      .modal-content

        .modal-header

          h5.modal-title
            | Event Occurrence

          button.btn-close(
            type='button'
            data-coreui-dismiss='modal'
          )

        .modal-body

          input(
            type='hidden'
            id='eventInstanceId'
          )

          .card.mb-4

            .card-header

              strong Event Bundle

            .card-body

              .row

                .col-md-4.mb-3

                  label.form-label Event Name

                  select.form-select(
                    id='eventId'
                  )
                    option(value='')
                      | Select Event Name

                .col-md-4.mb-3

                  label.form-label Event Category

                  input.form-control(
                    id='eventCategory'
                    readonly
                  )

                .col-md-4.mb-3

                  label.form-label Event Type

                  input.form-control(
                    id='eventType'
                    readonly
                  )

          .card.mb-4

            .card-header

              strong Event Occurrence Details

            .card-body

              .row

                .col-md-6.mb-3

                  label.form-label Organizer

                  input.form-control(
                    id='organizer'
                    placeholder='Organizer'
                  )

                .col-md-6.mb-3

                  label.form-label Sponsor

                  select.form-select(
                    id='sponsorId'
                  )
                    option(value='')
                      | Select Sponsor

              .row

                .col-md-3.mb-3

                  label.form-label Country

                  select.form-select(
                    id='countryId'
                  )
                    option(value='')
                      | Select Country

                .col-md-3.mb-3

                  label.form-label County

                  select.form-select(
                    id='countyId'
                  )
                    option(value='')
                      | Select County

                .col-md-3.mb-3

                  label.form-label Subcounty

                  select.form-select(
                    id='subcountyId'
                  )
                    option(value='')
                      | Select Subcounty

                .col-md-3.mb-3

                  label.form-label Town

                  input.form-control(
                    id='townName'
                    list='townSuggestions'
                    placeholder='Type or Select Town'
                  )

                  datalist#townSuggestions

              .row

                .col-md-6.mb-3

                  label.form-label Event Area

                  input.form-control(
                    id='eventArea'
                    readonly
                  )

          .card.mb-4

            .card-header

              strong Event Schedule

            .card-body

              .row

                .col-md-3.mb-3

                  label.form-label Start Date

                  input.form-control(
                    type='date'
                    id='startDate'
                  )

                .col-md-3.mb-3

                  label.form-label End Date

                  input.form-control(
                    type='date'
                    id='endDate'
                  )

                .col-md-3.mb-3

                  label.form-label Start Time

                  input.form-control(
                    type='time'
                    id='startTime'
                  )

                .col-md-3.mb-3

                  label.form-label End Time

                  input.form-control(
                    type='time'
                    id='endTime'
                  )

          
          
          .card.mb-4(
            id='occurrenceStatusCard'
          )

            .card-header

              strong Event Status

            .card-body

              .row

                .col-md-4.mb-3

                  label.form-label Event Status

                  select.form-select(
                    id='occurrenceStatusId'
                  )

                    option(value='')
                      | Select Status

          .alert.alert-danger.d-none(
            id='occurrenceError'
          )

        .modal-footer

          button.btn.btn-secondary(
            type='button'
            data-coreui-dismiss='modal'
          )
            | Close

          button.btn.btn-primary(
            type='button'
            id='btnSaveOccurrence'
          )
            | Save Same

          button.btn.btn-success(
            type='button'
            id='btnSaveOccurrenceAsNew'
          )
            | Save New
  .modal.fade(
    id='deleteOccurrenceModal'
    tabindex='-1'
    aria-hidden='true'
  )

    .modal-dialog

      .modal-content

        .modal-header.bg-danger.text-white

          h5.modal-title

            i.fa.fa-trash.me-2

            | Delete Event Occurrence

          button.btn-close(
            type='button'
            data-coreui-dismiss='modal'
          )

        .modal-body

          p
            | Are you sure you want to delete this Event Occurrence?

          p#deleteOccurrenceMessage.text-danger.fw-bold

        .modal-footer

          button.btn.btn-secondary(
            type='button'
            data-coreui-dismiss='modal'
          )
            | Cancel

          button.btn.btn-danger(
            type='button'
            id='btnConfirmDeleteOccurrence'
          )

            i.fa.fa-trash.me-2

            | Delete 

  .modal.fade(
    id='eventImportPreviewModal'
    tabindex='-1'
    aria-hidden='true'
  )

    .modal-dialog.modal-fullscreen

      .modal-content

        .modal-header

          h5.modal-title

            i.fa.fa-upload.me-2

            | Event Import Preview

          button.btn-close(
            type='button'
            data-coreui-dismiss='modal'
          )

        .modal-body

          .row.mb-4

            .col-md-3

              .card.text-bg-primary

                .card-body

                  h6 Total Rows

                  h3#importTotalRows 0

            .col-md-3

              .card.text-bg-success

                .card-body

                  h6 Valid

                  h3#importValidRows 0

            .col-md-3

              .card.text-bg-warning

                .card-body

                  h6 Warnings

                  h3#importWarningRows 0

            .col-md-3

              .card.text-bg-danger

                .card-body

                  h6 Errors

                  h3#importErrorRows 0

          .table-responsive

            table.table.table-bordered.table-hover

              thead#previewHeader

              tbody#previewBody

          hr

          h5 Errors

          div#importErrors

          hr

          h5 Warnings

          div#importWarnings

        .modal-footer

          button.btn.btn-secondary(
            type='button'
            data-coreui-dismiss='modal'
          )

            Cancel

          button.btn.btn-success(
            type='button'
            id='btnApproveImport'
          )

            Approve Import

  .modal.fade(
    id='eventImportSummaryModal'
    tabindex='-1'
  )

    .modal-dialog.modal-lg

      .modal-content

        .modal-header.bg-success.text-white

          h5.modal-title

            Import Summary

          button.btn-close(
            type='button'
            data-coreui-dismiss='modal'
          )

        .modal-body

          div#importSummary

        .modal-footer

          button.btn.btn-outline-primary(
            id='btnDownloadCsv'
          )

            CSV

          button.btn.btn-outline-success(
            id='btnDownloadExcel'
          )

            Excel

          button.btn.btn-outline-danger(
            id='btnDownloadPdf'
          )

            PDF

          button.btn.btn-secondary(
            data-coreui-dismiss='modal'
          )

            Close 
append pageScripts

  script(type='module' src='js/core/events/events.js')
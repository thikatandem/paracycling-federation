.sidebar.sidebar-dark.sidebar-fixed.border-end#sidebar

  .sidebar-header.border-bottom.d-flex.align-items-center.justify-content-between.px-3

    h5.mb-0.text-white
      | Thika Tandem

    button.btn-close.d-lg-none(
      type='button'
      data-coreui-theme="dark"
      aria-label='Close'
      onclick='coreui.Sidebar.getInstance(document.querySelector("#sidebar")).toggle()'
    )

  #roleSidebar(style='visibility: hidden')

    include sidebar-nav

  script.
    (() => {
      const nav = document.getElementById('roleSidebar')

      if (!nav) {
        return
      }

      window.__defaultRoleSidebarHtml = nav.innerHTML

      try {
        const authCache = JSON.parse(
          sessionStorage.getItem('thika-tandem.auth-context.v1') || 'null'
        )

        const shellCache = JSON.parse(
          sessionStorage.getItem('thika-tandem.sidebar-shell.v1') || 'null'
        )

        if (
          authCache?.userId &&
          shellCache?.userId === authCache.userId &&
          typeof shellCache.html === 'string' &&
          shellCache.html.trim()
        ) {
          nav.innerHTML = shellCache.html
          nav.style.visibility = 'visible'
          return
        }

        if (
          authCache?.userId &&
          authCache?.role?.role_code &&
          authCache.role.role_code !== 'ATHLETE'
        ) {
          nav.style.visibility = 'visible'
        }
      } catch {
        // Keep only the sidebar shell visible until auth resolves.
      }
    })()

  .sidebar-footer.border-top.d-none.d-md-flex

    button.sidebar-toggler(
      type="button"
      data-coreui-toggle="unfoldable"
    )

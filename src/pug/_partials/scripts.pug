script.
  const header = document.querySelector('header.header');

  document.addEventListener('scroll', () => {
    if (header) {
      header.classList.toggle('shadow-sm', document.documentElement.scrollTop > 0);
    }
  });

  // Keep normal HTML navigation, but warm the next internal page while
  // the user is hovering/focusing its link. Browsers treat prefetch as
  // low priority, so it does not block the current page.
  (() => {
    const prefetched = new Set();
    const connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;

    if (connection?.saveData || /(^|-)2g$/.test(connection?.effectiveType || '')) {
      return;
    }

    const prefetch = (target) => {
      const anchor = target?.closest?.('a[href]');

      if (!anchor) {
        return;
      }

      let url;

      try {
        url = new URL(anchor.href, window.location.href);
      } catch {
        return;
      }

      if (
        url.origin !== window.location.origin ||
        url.href === window.location.href ||
        !url.pathname.endsWith('.html') ||
        prefetched.has(url.href)
      ) {
        return;
      }

      prefetched.add(url.href);

      const link = document.createElement('link');
      link.rel = 'prefetch';
      link.href = url.href;
      link.as = 'document';
      document.head.appendChild(link);
    };

    document.addEventListener('pointerover', (event) => prefetch(event.target), { passive: true });
    document.addEventListener('focusin', (event) => prefetch(event.target));
  })();


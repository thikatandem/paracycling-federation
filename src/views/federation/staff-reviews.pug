extends ../../_layout/default

block view

  .container-fluid

    .row
      .col-12

        .card.mb-4

          .card-header.d-flex.justify-content-between.align-items-center.flex-wrap.gap-2

            div
              strong Staff Reviews
              .small.text-muted
                | Structured reviews use federation-defined templates, weighted criteria, evidence and development actions.

            .d-flex.gap-2
              button.btn.btn-outline-primary(
                type='button'
                id='btnManageReviewTemplates'
              )
                i.fa.fa-list-check.me-2
                | Manage Review Templates

              button.btn.btn-primary(
                type='button'
                id='btnAddReview'
              )
                i.fa.fa-plus.me-2
                | Add Review

          .card-body

            div.alert.d-none.mb-3(
              id='reviewPageFeedback'
              role='status'
              aria-live='polite'
            )

            div.d-none.text-center.mb-3(
              id='reviewLoading'
            )
              .spinner-border.text-primary

            .row.mb-3
              .col-md-5
                input.form-control(
                  type='text'
                  id='searchReview'
                  placeholder='Search staff, reviewer, template, status or review content'
                )

            .table-responsive
              table.table.table-striped.table-hover.align-middle
                thead
                  tr
                    th Staff
                    th Review Period
                    th Review Date
                    th Reviewer
                    th Template
                    th Overall Score
                    th Status
                    th Next Review
                    th Actions
                tbody#reviewsTableBody

            .row.mt-3
              .col-md-6
                button.btn.btn-secondary(
                  type='button'
                  id='btnRefreshReviews'
                )
                  | Refresh

              .col-md-6.text-end
                button.btn.btn-outline-primary.me-2(
                  type='button'
                  id='btnPreviousReviewPage'
                )
                  | Previous

                span#reviewPaginationInfo.mx-2
                  | Page 1

                button.btn.btn-outline-primary(
                  type='button'
                  id='btnNextReviewPage'
                )
                  | Next

  .modal.fade(
    id='reviewModal'
    tabindex='-1'
    aria-hidden='true'
  )

    .modal-dialog.modal-xl.modal-dialog-scrollable

      .modal-content

        .modal-header
          h5.modal-title
            | Staff Performance Review

          button.btn-close(
            type='button'
            data-coreui-dismiss='modal'
          )

        .modal-body

          input(
            type='hidden'
            id='reviewId'
          )

          .row.g-3.mb-4

            .col-md-6
              label.form-label Staff Member
              select.form-select(
                id='reviewStaffId'
                required
              )

            .col-md-6
              label.form-label Review Template
              select.form-select(
                id='reviewTemplateId'
                required
              )
              .form-text
                | Templates define the actual criteria and weights; the system does not invent a generic rubric.

            .col-md-3
              label.form-label Review Period Start
              input.form-control(
                type='date'
                id='reviewPeriodStart'
              )

            .col-md-3
              label.form-label Review Period End
              input.form-control(
                type='date'
                id='reviewPeriodEnd'
              )

            .col-md-3
              label.form-label Review Date
              input.form-control(
                type='date'
                id='reviewDate'
                required
              )

            .col-md-3
              label.form-label Next Review Date
              input.form-control(
                type='date'
                id='reviewNextDate'
              )

            .col-md-6
              label.form-label Reviewer
              select.form-select(
                id='reviewerProfileId'
                required
              )

            .col-md-3
              label.form-label Review Status
              select.form-select(
                id='reviewStatus'
              )
                option(value='DRAFT') Draft
                option(value='IN_PROGRESS') In Progress
                option(value='COMPLETED') Completed
                option(value='ACKNOWLEDGED') Acknowledged

            .col-md-3
              label.form-label Weighted Overall Score
              input.form-control(
                id='reviewOverallScore'
                readonly
              )

          .card.mb-4
            .card-header
              strong Criteria Ratings & Evidence
            .card-body
              #reviewCriteriaContainer
                .text-muted
                  | Choose a review template to load its criteria.

          .row.g-3

            .col-md-6
              label.form-label Strengths Demonstrated
              textarea.form-control(
                rows='4'
                id='reviewStrengths'
                placeholder='Document specific strengths and evidence.'
              )

            .col-md-6
              label.form-label Improvement Areas
              textarea.form-control(
                rows='4'
                id='reviewImprovementAreas'
                placeholder='Document specific areas requiring improvement and evidence.'
              )

            .col-md-6
              label.form-label Goals / Commitments
              textarea.form-control(
                rows='4'
                id='reviewGoals'
                placeholder='Set measurable goals, expected outcomes and follow-up points.'
              )

            .col-md-6
              label.form-label Training / Development Needs
              textarea.form-control(
                rows='4'
                id='reviewTrainingNeeds'
                placeholder='Record coaching, training, certification or development needs.'
              )

            .col-md-6
              label.form-label Reviewer Summary
              textarea.form-control(
                rows='5'
                id='reviewComments'
                placeholder='Overall assessment, evidence, context and recommended action.'
              )

            .col-md-6
              label.form-label Staff Member Comments / Response
              textarea.form-control(
                rows='5'
                id='reviewEmployeeComments'
                placeholder='Record the staff member response, acknowledgement or disagreement.'
              )

          div.alert.d-none.mt-3(
            id='reviewFormError'
            role='alert'
            aria-live='assertive'
          )

        .modal-footer
          button.btn.btn-secondary(
            type='button'
            data-coreui-dismiss='modal'
          )
            | Cancel

          button.btn.btn-success(
            type='button'
            id='btnSaveReview'
          )
            | Save Review

  .modal.fade(
    id='reviewTemplateModal'
    tabindex='-1'
    aria-hidden='true'
  )

    .modal-dialog.modal-xl.modal-dialog-scrollable

      .modal-content

        .modal-header
          h5.modal-title Review Template Management
          button.btn-close(
            type='button'
            data-coreui-dismiss='modal'
          )

        .modal-body

          div.alert.d-none.mb-3(
            id='reviewTemplateFeedback'
            role='status'
            aria-live='polite'
          )

          .row.g-4

            .col-lg-4

              .d-flex.justify-content-between.align-items-center.mb-3
                h6.mb-0 Existing Templates
                button.btn.btn-sm.btn-outline-primary(
                  type='button'
                  id='btnNewReviewTemplate'
                )
                  | New

              .table-responsive
                table.table.table-sm.table-striped.align-middle
                  thead
                    tr
                      th Code
                      th Template
                      th Status
                      th Actions
                  tbody#reviewTemplatesTableBody

            .col-lg-8

              input(
                type='hidden'
                id='reviewTemplateAdminId'
              )

              .row.g-3.mb-3

                .col-md-4
                  label.form-label Template Code
                  input.form-control(
                    id='reviewTemplateCode'
                  )

                .col-md-8
                  label.form-label Template Name
                  input.form-control(
                    id='reviewTemplateName'
                  )

                .col-md-12
                  label.form-label Purpose / Description
                  textarea.form-control(
                    rows='3'
                    id='reviewTemplateDescription'
                  )

                .col-md-4
                  .form-check.form-switch.mt-4
                    input.form-check-input(
                      type='checkbox'
                      id='reviewTemplateActive'
                      checked
                    )
                    label.form-check-label(
                      for='reviewTemplateActive'
                    )
                      | Active Template

              .d-flex.justify-content-between.align-items-center.mb-2
                h6.mb-0 Review Criteria
                button.btn.btn-sm.btn-outline-primary(
                  type='button'
                  id='btnAddReviewCriterion'
                )
                  | Add Criterion

              .table-responsive
                table.table.table-bordered.align-middle
                  thead
                    tr
                      th Code
                      th Criterion
                      th Description / Evidence Expected
                      th Weight
                      th Max Score
                      th Action
                  tbody#reviewTemplateCriteriaBody

              button.btn.btn-success.w-100(
                type='button'
                id='btnSaveReviewTemplate'
              )
                | Save Review Template

        .modal-footer
          button.btn.btn-secondary(
            type='button'
            data-coreui-dismiss='modal'
          )
            | Close

  .modal.fade(
    id='deleteReviewModal'
    tabindex='-1'
    aria-hidden='true'
  )

    .modal-dialog
      .modal-content

        .modal-header
          h5.modal-title Delete Review
          button.btn-close(
            type='button'
            data-coreui-dismiss='modal'
          )

        .modal-body
          p
            | Are you sure you want to delete this review and its criterion ratings?
          input(
            type='hidden'
            id='deleteReviewId'
          )

        .modal-footer
          button.btn.btn-secondary(
            type='button'
            data-coreui-dismiss='modal'
          )
            | Cancel

          button.btn.btn-danger(
            type='button'
            id='btnConfirmDeleteReview'
          )
            | Delete Review

block append pageScripts

  script(
    type='module'
    src='js/core/staff/staff-reviews.js'
  )
